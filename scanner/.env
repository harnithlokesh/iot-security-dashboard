# scanner/.env - scanner service configuration
BACKEND_URL=http://127.0.0.1:5000/api
SCAN_INTERFACE=Wi-Fi
WHITELIST_FILE=whitelist.txt
LOG_FILE=scanner.log
QUARANTINE_ENABLED=false
DEBOUNCE_SECONDS=3
#BACKEND_URL=http://127.0.0.1:5000
DEVICE_SCAN_INTERVAL=60
REPORT_INTERVAL=60

# Scanner service control (Flask API)
SCANNER_SERVICE_PORT=9000
SCANNER_API_TOKEN=supersecret_scanner_token   # change this to a strong value
SCANNER_AUTO_START=true

# Router/Switch access details for quarantine (if applicable)
ROUTER_TYPE=auto
#ROUTER_IP=192.168.0.1
ROUTER_USER=admin
ROUTER_PASS=Admin@123

